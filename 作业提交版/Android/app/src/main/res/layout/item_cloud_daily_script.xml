<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_job_station_card"
    android:clickable="true"
    android:elevation="2dp"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/tv_cloud_item_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:maxLines="2"
        android:textColor="#2C241B"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="日常一键收菜脚本" />

    <TextView
        android:id="@+id/tv_cloud_item_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#5E4C37"
        android:textSize="13sp"
        tools:text="包含鸟食、行囊和常规领取流程" />

    <LinearLayout
        android:id="@+id/ll_cloud_item_author_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.cardview.widget.CardView
            android:layout_width="18dp"
            android:layout_height="18dp"
            app:cardBackgroundColor="#EADDC5"
            app:cardCornerRadius="9dp">

            <ImageView
                android:id="@+id/iv_cloud_item_author_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:src="@drawable/cover" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tv_cloud_item_author"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#7F6E57"
            android:textSize="12sp"
            tools:text="热心玩家" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_cloud_item_bottom_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <HorizontalScrollView
            android:id="@+id/scroll_cloud_item_tags"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layout_cloud_item_tags"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tv_cloud_item_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#A89B84"
            android:textSize="11sp"
            tools:text="2步 · 5次下载" />
    </LinearLayout>
</LinearLayout>
