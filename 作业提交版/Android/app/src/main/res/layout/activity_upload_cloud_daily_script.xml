<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F3EA"
    android:orientation="vertical">

    <View
        android:id="@+id/view_upload_cloud_status_bar_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/btn_upload_cloud_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_job_station_icon_button"
            android:contentDescription="返回"
            android:padding="10dp"
            android:src="@drawable/ic_back_arrow"
            app:tint="#5C4D35" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="serif"
            android:text="上传云端脚本"
            android:textColor="#3D3222"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_job_station_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <Button
                    android:id="@+id/btn_select_cloud_local_script"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_job_station_chip"
                    android:text="选择本地录制脚本"
                    android:textColor="#6B4E1C"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_selected_cloud_local_script"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="未选择"
                    android:textColor="#7F6E57"
                    android:textSize="13sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/et_upload_cloud_title"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_job_station_icon_button"
                android:hint="标题"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#4E3C1E"
                android:textColorHint="#9A8A71" />

            <EditText
                android:id="@+id/et_upload_cloud_description"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_job_station_icon_button"
                android:gravity="top"
                android:hint="说明"
                android:padding="14dp"
                android:textColor="#4E3C1E"
                android:textColorHint="#9A8A71" />

            <EditText
                android:id="@+id/et_upload_cloud_tags"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_job_station_icon_button"
                android:hint="标签，用空格分隔"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#4E3C1E"
                android:textColorHint="#9A8A71" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_job_station_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="图片指引"
                    android:textColor="#3D3222"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_select_cloud_guide_images"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_job_station_icon_button"
                    android:text="选择图片"
                    android:textColor="#6B4E1C"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layout_upload_cloud_guide_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress_upload_cloud_daily_script"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_publish_cloud_daily_script"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_job_station_chip"
                android:text="发布"
                android:textColor="#6B4E1C"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
