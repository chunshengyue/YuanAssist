<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application
        android:name=".core.YuanAssistApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.YuanAssist">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <activity
            android:name=".ui.RunLogActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.FaqActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.MyPublishedActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.MyFavoriteActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.MyMessageActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.FeedbackCenterActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.FeedbackAdminActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.MyStoneActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.LegacyFragmentHostActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ScriptLibraryActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.OneKeyDailyActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.RecordedDailyScriptViewerActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.StrategyDetailActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.JobStationActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.JobStationListActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.CloudDailyScriptListActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.CloudDailyScriptActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.UploadCloudDailyScriptActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.ImagePickerActivity"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar"            android:excludeFromRecents="true"
            android:exported="false" />
        <activity
            android:name=".ui.CharacterImportReviewActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity android:name=".ui.UploadStrategyActivity" />

        <service
            android:name=".core.YuanAssistService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
