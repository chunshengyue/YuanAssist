<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="10dp"
    android:paddingEnd="4dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:id="@+id/layout_excluded_agent_avatar_frame"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_dark_hollow"
        android:padding="2dp">

        <ImageView
            android:id="@+id/iv_excluded_agent_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <View
            android:id="@+id/view_excluded_agent_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#00000000" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_excluded_agent_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#E0E0E0"
        android:textSize="12sp" />
</LinearLayout>
